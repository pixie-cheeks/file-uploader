{
  "name": "file-uploader",
  "version": "1.0.0",
  "main": "src/app.ts",
  "private": true,
  "scripts": {
    "build": "tsx bin/build.ts",
    "build:js": "pnpm babel src/browser/scripts -d src/public/scripts",
    "dev": "concurrently --kill-others --names \"Server,JS,Prisma Studio,Prisma Generate\" 'pnpm watch:server' 'pnpm watch:js' 'pnpm prisma studio' 'pnpm prisma generate --watch'",
    "watch:server": "tsx --watch .",
    "watch:js": "pnpm build:js --watch",
    "prepare": "husky .config/husky",
    "eslint": "eslint --config .config/eslint.ts --max-warnings 0",
    "prettier": "prettier --config .config/prettier/config.ts --ignore-path=.gitignore --ignore-path=.config/prettier/ignore",
    "babel": "babel --config-file ./.config/babel.ts --extensions '.ts'",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "files": [],
  "engines": {
    "node": "^24.19.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "devDependencies": {
    "@awmottaz/prettier-plugin-void-html": "2.3.0",
    "@babel/cli": "8.0.6",
    "@babel/core": "8.0.6",
    "@babel/preset-env": "8.0.6",
    "@babel/preset-typescript": "8.0.1",
    "@pixie-cheeks/eslint-config": "21.0.0",
    "@types/express": "5.0.6",
    "@types/express-ejs-layouts": "2.5.4",
    "@types/express-session": "1.19.0",
    "@types/multer": "2.2.0",
    "@types/node": "26.6.2",
    "@types/passport": "1.0.17",
    "@types/passport-local": "1.0.38",
    "@types/pg": "8.23.1",
    "@types/shelljs": "0.10.0",
    "concurrently": "10.0.5",
    "cspell": "10.3.3",
    "ejs-lint": "2.0.1",
    "eslint": "10.11.0",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "prisma": "7.10.0",
    "shelljs": "0.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@quixo3/prisma-session-store": "3.1.21",
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.1",
    "ejs": "6.0.1",
    "express": "5.2.1",
    "express-ejs-layouts": "2.5.1",
    "express-session": "1.19.0",
    "multer": "2.4.0",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "pg": "8.23.0",
    "zod": "4.6.5"
  }
}
