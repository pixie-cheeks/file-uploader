{
  "eslint.options": {
    "overrideConfigFile": ".config/eslint.ts"
  },
  "prettier.ignorePath": ".config/prettier/ignore",
  "prettier.configPath": ".config/prettier/config.ts",
  "files.associations": {
    ".config/babel.ts": "babel",
    "*.ejs": "html"
  },
  "htmlhint.options": {
    "spec-char-escape": false
  },
  "[html]": {
    "editor.defaultFormatter": "besthyhy.ejs-eta-beautify"
  }
}
