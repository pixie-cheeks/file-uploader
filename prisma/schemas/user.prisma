model User {
  id        Int    @id @default(autoincrement())
  firstName String
  lastName  String
  username  String @unique
  password  String
  files     File[]
}

model File {
  id         Int      @id @default(autoincrement())
  name       String
  path       String
  mimetype   String
  size       Int
  uploadedOn DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
}
