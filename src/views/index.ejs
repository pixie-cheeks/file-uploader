<h1>Hello World!</h1>

<% if (locals.currentUser) { %>

<% const {files} = currentUser %>
<a href="/upload/folder">Add a Folder</a>
<a href="/upload/file">Upload a New File</a>

<h1>Upload a file!</h1>

<form action="/upload/file" method="post" enctype="multipart/form-data">
  <div class="form__field">
    <label for="upload-file">File to Upload</label>
    <input type="file" id="upload-file" name="uploadFile" class="form__input" />
  </div>

  <button type="submit">Upload</button>
</form>


<p>Your files here:</p>

<% if (files.length > 0) { %>
<ul>
  <% files.forEach(({id, name, size, uploadedOn}) => { %>
  <li>
    <dl>
      <dt>Name</dt>
      <dd><%= name %></dd>
      <dt>Size</dt>
      <dd><%= size %></dd>
      <dt>Uploaded On</dt>
      <dd><%= uploadedOn %></dd>
    </dl>
    <a href="/download/file?id=<%= id %>">Download</a>
  </li>

  <% }) %>

</ul>
<% } else { %>
<p>No files uploaded! Lol!</p>
<% } %>

<% } %>