<h1>Hello World!</h1>

<% if (locals.currentUser) { %>

<% const {files} = currentUser %>
<a href="/upload/folder">Add a Folder</a>
<a href="/upload/file">Upload a New File</a>

<p>Your files here:</p>

<% if (files.length > 0) { %>
<ul>
  <% files.forEach(({id, name, size, uploadedOn}) => { %>
  <li>
    <dl>
      <dt>Name</dt>
      <dd><%= name %></dd>
      <dt>Size</dt>
      <dd><%= size %></dd>
      <dt>Uploaded On</dt>
      <dd><%= uploadedOn %></dd>
    </dl>
    <a href="/download/file?id=<%= id %>">Download</a>
  </li>

  <% }) %>

</ul>
<% } else { %>
<p>No files uploaded! Lol!</p>
<% } %>

<% } %>