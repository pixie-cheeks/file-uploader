echo "Check ejs files for errors"
ejslint src/**/*.ejs
echo "Done checking ejs files for errors"

echo "Checking for spelling errors..."
cspell .
echo "Finished checking for spelling errors!"

echo "Checking for formatting issues..."
pnpm prettier --check --ignore-unknown .
echo "Finished checking for formatting issues!"

echo "Checking for typescript issues..."
tsc
tsc -p src/browser/tsconfig.json
echo "Finished checking for typescript issues!"

echo "Checking for eslint issues..."
pnpm eslint
echo "Finished checking for eslint issues!"